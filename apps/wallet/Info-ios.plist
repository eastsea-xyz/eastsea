<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- eastsea://pay?to=…&amount=… (and the legacy aether:// links): web pages reach the wallet without an extension. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.pipln.eastsea.pay</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sea</string>
				<string>eastsea</string>
				<string>aether</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
