<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Founder policy: default-on preselects the first-launch choice; ask-before-sending
	     requires an explicit share/decline choice. Both send no country before an answer. -->
	<key>PresenceCountrySharingMode</key>
	<string>default-on</string>
	<!-- Sparkle: signed appcast on the GitHub release feed (EdDSA public key). EastSea has its own
	     feed; appcast.xml is the legacy one Aether <= 0.6.6 reads, which lists the Aether bridge. -->
	<!-- 블록 데이터 위치: the node's chain data may live on an external disk the person picks. -->
	<key>NSRemovableVolumesUsageDescription</key>
	<string>EastSea keeps the node's block data on the disk you chose. Your keys stay on this Mac.</string>
	<key>SUFeedURL</key>
	<string>https://github.com/eastsea-xyz/eastsea/releases/latest/download/eastsea-appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>owZzXbcYSAs74399TEZ7qMetNlTCsZqgj7rNYO9ny6E=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Update checks need the app version; optional system-profile uploads are disabled. -->
	<key>SUEnableSystemProfiling</key>
	<false/>
	<!-- Hourly checks (Sparkle's minimum); updates install in the background and apply on the next launch. -->
	<key>SUScheduledCheckInterval</key>
	<integer>3600</integer>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<!-- eastsea://pay?to=…&amount=… (and the legacy aether:// links): web pages reach the wallet without an extension. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.pipln.eastsea.pay</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>eastsea</string>
				<string>aether</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
