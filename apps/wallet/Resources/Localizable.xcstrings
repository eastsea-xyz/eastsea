    "An upgrade or guardian recovery cannot revoke this account’s original key. If it may be exposed, use a new account created on a trusted device." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An upgrade or guardian recovery cannot revoke this account’s original key. If it may be exposed, use a new account created on a trusted device."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップグレードやガーディアンによる復旧では、このアカウントの元の鍵を無効にできません。鍵が漏えいした可能性がある場合は、信頼できるデバイスで作成した新しいアカウントを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업그레이드나 보호자 복구로는 이 계정의 원래 키 권한을 취소할 수 없어요. 키가 노출됐을 수 있다면, 믿을 수 있는 기기에서 만든 새 계정을 사용해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "升级或守护人恢复无法撤销此账户原始密钥的权限。如果密钥可能已泄露，请使用在可信设备上创建的新账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "升級或守護者復原無法撤銷此帳戶原始金鑰的權限。如果金鑰可能已外洩，請使用在可信裝置上建立的新帳戶。"
          }
        }
