    "%@ is built for production. Mainnet has not launched yet; the network running today is the public testnet, and its %@ does not carry over. It is provided as is, without warranty, and has not had an independent security audit yet." : {
      "comment" : "legal-English: reviewed English and Korean legal body only; other languages retain English.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is built for production. Mainnet has not launched yet; the network running today is the public testnet, and its %@ does not carry over. It is provided as is, without warranty, and has not had an independent security audit yet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is built for production. Mainnet has not launched yet; the network running today is the public testnet, and its %@ does not carry over. It is provided as is, without warranty, and has not had an independent security audit yet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@는 실제 서비스를 목표로 만들었어요. 메인넷은 아직 시작하지 않았고, 지금 돌아가는 네트워크는 공개 테스트넷이라 여기의 %@ 잔액은 메인넷으로 넘어가지 않아요. 아무 보증 없이 있는 그대로 제공되며, 아직 독립적인 보안 감사를 받지 않았어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is built for production. Mainnet has not launched yet; the network running today is the public testnet, and its %@ does not carry over. It is provided as is, without warranty, and has not had an independent security audit yet."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is built for production. Mainnet has not launched yet; the network running today is the public testnet, and its %@ does not carry over. It is provided as is, without warranty, and has not had an independent security audit yet."
          }
        }
      }
    },
