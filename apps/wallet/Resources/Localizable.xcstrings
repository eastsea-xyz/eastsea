    "Add another address to see one combined history. This is view only; signing keys stay in their own wallets." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add another address to see one combined history. This is view only; signing keys stay in their own wallets."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のアドレスを追加すると、履歴をまとめて確認できます。閲覧専用です。署名キーはそれぞれのウォレットに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 주소를 추가하면 내역을 한곳에서 볼 수 있어요. 보기만 할 뿐, 서명 키는 각자의 지갑에 그대로 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加其他地址，即可在此查看合并的记录。这仅用于查看，签名密钥仍留在各自的钱包中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增其他地址，即可在同一處查看紀錄。這只供查看，簽署金鑰仍留在各自的錢包中。"
          }
        }
      }
    },
