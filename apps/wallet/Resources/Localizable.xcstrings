        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此节点的密钥来自另一台 Mac。请在原来的 Mac 上恢复密钥；如果您是有意迁移此节点，请在此 Mac 上重新绑定密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此節點的金鑰來自另一台 Mac。請在原來的 Mac 上還原金鑰；如果您是刻意移轉此節點，請在此 Mac 上重新綁定金鑰。"
          }
        }
