    },
    "There is no reward for keeping it. It helps anyone verify the network's whole history." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no reward for keeping it. It helps anyone verify the network's whole history."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管に対する報酬はありません。誰でもネットワークの全履歴を検証できるようにするための選択です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관에 대한 보상은 없어요. 네트워크의 전체 기록을 누구나 검증할 수 있게 돕는 선택이에요."
