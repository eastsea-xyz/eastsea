    "This node's keys came from another Mac. Restore them on the original Mac, or rebind them here if you intentionally moved this node." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This node's keys came from another Mac. Restore them on the original Mac, or rebind them here if you intentionally moved this node."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このノードのキーは別のMacから移されたものです。元のMacに復元するか、ノードを意図的に移した場合は、このMacにキーを再関連付けしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 노드의 키가 다른 Mac에서 옮겨 왔어요. 원래 Mac에 복원하거나, 노드를 의도적으로 옮겼다면 이 Mac에 키를 다시 연결해 주세요."
          }
