    "Proving rests for a moment: it used a lot of memory. It resumes by itself." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proving rests for a moment: it used a lot of memory. It resumes by itself."
          }
        },
        "ja" : {
