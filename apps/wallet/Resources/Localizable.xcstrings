          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウェブページが署名を求めています。承認する前に内容を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹페이지에서 서명을 요청했어요. 승인하기 전에 내용을 확인해 주세요."
          }
        },
