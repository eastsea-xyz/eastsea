    "Stopping takes the agents' permission to pay away at once, with Touch ID. Payments already sent stay sent." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopping takes the agents' permission to pay away at once, with Touch ID. Payments already sent stay sent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch IDで確認すると、エージェントの支払い権限をすぐに取り消します。すでに送った支払いは戻りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "멈추면 Touch ID 확인 후 에이전트의 결제 권한이 바로 사라져요. 이미 보낸 결제는 되돌려지지 않아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Touch ID 停止后，代理的付款权限会立即撤销。已发送的付款仍然有效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止時會透過 Touch ID 立即撤銷代理的付款權限。已傳出的付款無法撤回。"
          }
        }
      }
    },
    "Storage is full. The node restarts by itself once 7 GB is free." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storage is full. The node restarts by itself once 7 GB is free."
