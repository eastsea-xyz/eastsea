          }
        }
      }
    },
    "The founder's only special permission: one Mac may run up to 3 reserve validator keys, and only while the network needs them. Hours they serve count as the founder's participation, under the same 1/16 cap as everyone; they add no extra share." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The founder's only special permission: one Mac may run up to 3 reserve validator keys, and only while the network needs them. Hours they serve count as the founder's participation, under the same 1/16 cap as everyone; they add no extra share."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "創業者に認められる唯一の特例は、1台のMacで予備の検証者キーを最大3つまで動かせることです。ネットワークに必要な間だけ使えます。稼働時間は創業者の参加として数え、全員と同じ1/16の上限に従います。追加の取り分はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창업자에게 하나뿐인 예외: Mac 한 대가 예비 서명 키를 최대 3개까지, 네트워크에 필요할 때만 돌릴 수 있어요. 그 시간은 창업자의 참여로 세고, 모두와 같은 1/16 한도를 따르며 몫이 늘지 않아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创始人唯一的特殊权限是：网络需要时，一台 Mac 最多可运行 3 个备用验证者密钥。服务时长计入创始人的参与时长，遵守与其他人相同的 1/16 上限，不会增加份额。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "創辦人唯一的特許：一部 Mac 最多可執行 3 個備用驗證者金鑰，且僅限網路需要時。執行時數算入創辦人的參與，和所有人一樣受 1/16 上限約束，不會增加份額。"
          }
        }
      }
    },
    "The full history is about %@ today and grows by about %@ a month." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The full history is about %@ today and grows by about %@ a month."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在、全履歴は約%@で、1か月に約%@ずつ増えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 전체 기록은 약 %@이고, 한 달에 약 %@씩 늘어나요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前完整历史约为 %@，每月增加约 %@。"
          }
        },
