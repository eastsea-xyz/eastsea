    "This disk's format (%@) is not safe for block data. Erase it as APFS in Disk Utility to use it (this deletes the files on the disk)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This disk's format (%@) is not safe for block data. Erase it as APFS in Disk Utility to use it (this deletes the files on the disk)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このディスクの形式（%@）はブロックデータの保存に適していません。ディスクユーティリティでAPFS形式に消去すると使えます（ディスク内のファイルは削除されます）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 디스크는 블록 저장에 안전하지 않은 형식(%@)이에요. 디스크 유틸리티에서 APFS로 지우면 쓸 수 있어요 (디스크 안의 파일은 지워져요)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此磁盘的格式 %@ 不适合安全存储区块数据。请在磁盘工具中抹掉并格式化为 APFS，这会删除磁盘上的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此磁碟格式（%@）無法安全儲存區塊資料。請在「磁碟工具程式」中以 APFS 格式清除後使用（會刪除磁碟上的檔案）。"
          }
        }
      }
