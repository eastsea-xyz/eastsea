    },
    "One Mac, one voting node. Your Mac proves it is online every hour; the longest-running Macs are picked to sign blocks, and no single operator address can hold a third of the seats." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One Mac, one voting node. Your Mac proves it is online every hour; the longest-running Macs are picked to sign blocks, and no single operator address can hold a third of the seats."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1台のMacに投票ノードは1つです。Macは毎時間、接続していることを証明します。長く稼働したMacからブロックへの署名を担当します。1つの運用者アドレスが席の3分の1以上を持つことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 한 대에 투표 노드 하나예요. Mac이 매시간 켜져 있음을 증명하고, 가장 오래 켜져 있던 Mac들이 블록 서명에 뽑혀요. 한 운영자 주소가 자리의 3분의 1 이상을 가질 수는 없어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一台 Mac，一个投票节点。Mac 每小时证明自己在线，持续运行最久的 Mac 会被选中签名，单个运营者地址无法占据三分之一的席位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每部 Mac 一個投票節點。Mac 每小時證明自己保持連線，連線最久的 Mac 會獲選簽署區塊。任何單一營運者地址都不能持有三分之一的席位。"
          }
        }
      }
    },
    "One data folder is inside the other. Choose a separate folder and reopen the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One data folder is inside the other. Choose a separate folder and reopen the app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一方のデータフォルダがもう一方の中にあります。別のフォルダを選び、アプリを開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터 폴더 하나가 다른 폴더 안에 있어요. 다른 폴더를 고르고 앱을 다시 열어 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个数据文件夹位于另一个内，请选择单独的文件夹并重新打开应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其中一個資料夾位於另一個裡面，請選擇獨立的資料夾後重新開啟應用程式。"
          }
        }
      }
    },
    "One more step: allow %@ in System Settings ▸ General ▸ Login Items. Until then this does not run." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One more step: allow %@ in System Settings ▸ General ▸ Login Items. Until then this does not run."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう1つ手順があります。システム設定 ▸ 一般 ▸ ログイン項目で%@を許可してください。それまでは動作しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 단계 남았어요: 시스템 설정 ▸ 일반 ▸ 로그인 항목에서 %@를 허용해 주세요. 그 전까지는 동작하지 않아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还差一步：在“系统设置”▸“通用”▸“登录项”中允许 %@。允许前不会运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還有一步：在「系統設定」▸「一般」▸「登入項目」中允許 %@。允許前不會執行。"
          }
        }
      }
    },
    "Online" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稼働時間"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜져 있던 시간"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在线"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連線時間"
          }
        }
      }
    },
    "Only continue if you started this on %@. A refused request sends nothing." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only continue if you started this on %@. A refused request sends nothing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@で自分が開始した場合にだけ続けてください。拒否した依頼では何も送りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 직접 시작한 경우에만 계속하세요. 거절하면 아무것도 보내지 않아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当你在 %@ 上发起此操作时才继续。拒绝请求不会发送任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在 %@ 上由你發起時才繼續。拒絕請求不會傳送任何內容。"
          }
        }
      }
    },
    "Only do this if you moved this Mac's node on purpose; running the same keys on two Macs gets the validator slashed." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only do this if you moved this Mac's node on purpose; running the same keys on two Macs gets the validator slashed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacのノードを意図的に移した場合にのみ続行してください。同じキーを2台のMacで使うと、検証者がスラッシングを受けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac의 노드를 의도적으로 옮긴 경우에만 진행하세요. 같은 키를 두 Mac에서 실행하면 검증인이 슬래싱됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在您有意迁移此 Mac 的节点时继续。在两台 Mac 上使用相同密钥运行节点，会导致验证者被罚没。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在您刻意移轉此 Mac 的節點時繼續。在兩台 Mac 上使用相同金鑰執行節點，會導致驗證者遭到罰沒。"
          }
        }
      }
    },
    "Only the block data moves; the keys and the node's identity stay on this Mac. APFS or Mac OS Extended disks only." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the block data moves; the keys and the node's identity stay on this Mac. APFS or Mac OS Extended disks only."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動するのはブロックデータだけです。キーとノードの識別情報はこのMacに残ります。APFSまたはMac OS拡張形式のディスクのみ使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "블록 데이터만 옮겨요. 키와 노드 신원은 이 Mac에 그대로 남아요. APFS 또는 Mac OS 확장 형식의 디스크만 쓸 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只移动区块数据，密钥和节点身份仍留在此 Mac 上。仅支持 APFS 或 Mac OS Extended 磁盘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只移動區塊資料，金鑰與節點身分會留在此 Mac。僅支援 APFS 或 Mac OS 擴充格式的磁碟。"
          }
        }
      }
    },
    "Only while on the power adapter" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only while on the power adapter"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電源アダプタ接続時のみ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전원 어댑터에 연결됐을 때만"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在使用电源适配器时"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在連接電源轉接器時"
          }
        }
      }
    },
    "Only works if that account trusted this device. The funds move after its safety delay (48 h by default); its owner can stop it meanwhile." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only works if that account trusted this device. The funds move after its safety delay (48 h by default); its owner can stop it meanwhile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのアカウントがこのデバイスを復旧用に指定している場合にだけ使えます。安全のための待機時間（初期値は48時間）が過ぎると資金が移り、それまでは所有者が止められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 계정이 이 기기를 복구 기기로 정해 둔 경우에만 돼요. 안전 대기(기본 48시간)가 지나면 돈이 옮겨지고, 그동안 계정 주인이 멈출 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当该账户信任此设备时有效。资金会在安全等待期后转移，默认为 48 小时；期间账户持有人可以取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有該帳戶信任此裝置時才適用。安全等候時間（預設 48 小時）過後會移動資金，帳戶擁有者可在這期間停止。"
          }
        }
      }
    },
