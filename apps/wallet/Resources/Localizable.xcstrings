    "This device checked the balance itself against the validators' signature, using the committee key shipped with the app instead of a server's word." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device checked the balance itself against the validators' signature, using the committee key shipped with the app instead of a server's word."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーの応答を信じる代わりに、アプリに含まれる委員会のキーを使い、このデバイスで検証者の署名と照合して残高を確認しました。"
          }
