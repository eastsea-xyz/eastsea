    "%@ %@ more itemized than the balance shows — try again in a moment" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ more itemized than the balance shows — try again in a moment"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内訳の合計が残高より%@ %@多くなっています。少し待って再確認してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내역 합계가 잔액보다 %@ %@ 많아요. 잠시 뒤 다시 확인해 주세요"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明细合计比余额多 %@ %@，请稍后重试"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明細總額比餘額多 %@ %@，請稍後再試"
          }
        }
      }
    },
    "%@ %@ not yet itemized — load older activity to account for it" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ not yet itemized — load older activity to account for it"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@の内訳がまだありません。過去の履歴を読み込むと確認できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@만큼은 아직 내역에 없어요. 이전 활동을 더 불러오면 채워져요"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ 尚未列入明细，加载更早的活动记录即可补全"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ 尚未列入明細，載入更早的活動即可補齊"
          }
        }
      }
    },
