        }
      }
    },
    "It shares its first and last characters with %@ — a different address. Scammers copy exactly those to catch a quick copy-paste. Compare the whole address, character by character, before sending." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It shares its first and last characters with %@ — a different address. Scammers copy exactly those to catch a quick copy-paste. Compare the whole address, character by character, before sending."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のアドレス%@と先頭と末尾の文字が同じです。詐欺では、急いでコピーして貼り付ける人を狙い、この部分をまねることがあります。送る前にアドレス全体を1文字ずつ比較してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 주소(%@)와 앞뒤 글자가 같아요. 사기꾼은 서둘러 복사·붙여넣기 하는 사람을 노려 바로 그 글자들을 흉내 내요. 보내기 전에 전체 주소를 한 글자씩 비교해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的开头和结尾与另一个地址 %@ 相同。骗子会模仿这些字符，利用匆忙复制粘贴的人。发送前，请逐字比较完整地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此地址的開頭與結尾字元和另一個地址 %@ 相同。詐騙者會刻意模仿這些字元，利用匆忙複製貼上的情況。傳送前，請逐一比對完整地址的每個字元。"
          }
        }
      }
    },
    "It starts by itself once the update is installed." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
