          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지구본은 이 Mac의 노드에서 보이는 네트워크를 표시해요. 노드마다 수가 다를 수 있어요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地球儀はこのMacのノードから見えるネットワークを表示します。台数はノードごとに異なる場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
