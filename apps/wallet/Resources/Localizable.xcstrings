    },
    "Message signing needs the current account code. An upgrade keeps your address, balances, recovery settings, and spending limits." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Message signing needs the current account code. An upgrade keeps your address, balances, recovery settings, and spending limits."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージへの署名には最新のアカウントコードが必要です。アップグレードしても、アドレス、残高、復旧設定、使用上限は維持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지에 서명하려면 최신 계정 코드가 필요해요. 업그레이드해도 주소, 잔액, 복구 설정, 사용 한도는 유지돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消息签名需要最新的账户代码。升级后，地址、余额、恢复设置和支出限额都会保留。"
          }
        },
        "zh-Hant" : {
