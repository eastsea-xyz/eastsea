    },
    "This token is not on the wallet’s trusted list, so sending it needs your confirmation of the exact number of units." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This token is not on the wallet’s trusted list, so sending it needs your confirmation of the exact number of units."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このトークンはウォレットの信頼する一覧にありません。送るには正確な単位数の確認が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지갑의 신뢰 목록에 없는 토큰이라, 보내려면 정확한 단위 수를 확인해 주셔야 해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此代币不在钱包的信任列表中，发送前需要你确认准确的单位数量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
