    "%@ wants to see your address %@. It cannot move funds: every payment or call still asks you here." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wants to see your address %@. It cannot move funds: every payment or call still asks you here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がアドレス%@の閲覧を求めています。資金を動かすことはできません。支払いや呼び出しは毎回ここで確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 내 주소(%@)를 보려고 해요. 주소만 보여 주므로 돈을 옮길 수는 없어요. 결제나 요청은 매번 여기서 다시 물어봐요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 想查看你的地址 %@。它无法转移资金，每次付款或调用仍会在此征求同意。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 想查看你的地址 %@。查看地址無法移動資金，每次付款或呼叫仍會在這裡詢問你。"
          }
        }
      }
    },
