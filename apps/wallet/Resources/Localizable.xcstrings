    "The network's rules changed, so this app needs an update. Until then your balance is checked through other nodes." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The network's rules changed, so this app needs an update. Until then your balance is checked through other nodes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
