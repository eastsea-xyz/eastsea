          }
        }
      }
    },
    "A secondary disk (an external SSD, say) with at least %@ free is recommended. Pick it under Block data location above." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A secondary disk (an external SSD, say) with at least %@ free is recommended. Pick it under Block data location above."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@以上の空き容量がある別のディスク（外付けSSDなど）をおすすめします。上の「ブロックデータの保存先」で選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이상 비어 있는 보조 디스크(외장 SSD 등)를 권해요. 위의 ‘블록 데이터 위치’에서 고를 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建议使用空闲至少 %@ 的辅助磁盘，例如外置 SSD。可在上方的“区块数据位置”中选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建議使用至少有 %@ 可用空間的第二個磁碟，例如外接 SSD。可在上方「區塊資料位置」中選擇。"
          }
        }
      }
    },
    "A small one-time fee on first use" : {
