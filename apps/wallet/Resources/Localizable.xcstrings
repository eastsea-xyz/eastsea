          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일은 다운로드 폴더에 저장돼요. 다운로드한 파일은 자동으로 열리지 않아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
