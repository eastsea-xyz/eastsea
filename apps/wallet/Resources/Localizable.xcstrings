    "%@ %@ not yet itemized — load older activity to account for it" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@만큼은 아직 내역에 없어요. 이전 활동을 더 불러오면 채워져요"
