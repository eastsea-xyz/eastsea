      }
    },
    "You are about to open **%@**. Explore shows pages like any browser: the site's content is the site's, not %@'s." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are about to open **%@**. Explore shows pages like any browser: the site's content is the site's, not %@'s."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**%@**を開こうとしています。探索は通常のブラウザと同じようにページを表示します。サイトの内容はそのサイトのもので、%@のものではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**%@** 사이트를 열려고 해요. 둘러보기는 보통 브라우저처럼 페이지를 보여 줘요. 사이트 내용은 그 사이트의 것이고 %@의 것이 아니에요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你即将打开 **%@**。“浏览”与一般浏览器一样显示网页，网站内容属于该网站，不属于 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即將開啟 **%@**。「探索」會像一般瀏覽器一樣顯示網頁，網站內容屬於該網站，並非 %@ 的內容。"
          }
        }
      }
    },
    "You can take this back any time in Security → Connected sites." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can take this back any time in Security → Connected sites."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつでも「セキュリティ」→「接続済みのサイト」で取り消せます。"
          }
