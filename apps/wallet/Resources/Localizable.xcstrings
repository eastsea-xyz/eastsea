        }
      }
    },
    "Nothing yet. Payments you send and receive show up here." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 없어요. 보내고 받은 결제가 여기에 나타나요."
