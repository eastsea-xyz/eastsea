    "%@ %@ more itemized than the balance shows — try again in a moment" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내역 합계가 잔액보다 %@ %@ 많아요. 잠시 뒤 다시 확인해 주세요"
