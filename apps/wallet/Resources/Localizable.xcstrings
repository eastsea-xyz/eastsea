      }
    },
    "Your wallet and node data are copied and checked, byte by byte. This can take a few minutes. Keep %@ open; if it is closed, the move picks up where it left off next time." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your wallet and node data are copied and checked, byte by byte. This can take a few minutes. Keep %@ open; if it is closed, the move picks up where it left off next time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォレットとノードのデータを1バイトずつコピーして確認しています。数分かかることがあります。%@を開いたままにしてください。閉じた場合は、次に開いたときに続きから移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지갑과 노드 데이터를 한 바이트씩 복사하고 확인하고 있어요. 몇 분 걸릴 수 있어요. %@를 열어 두세요. 닫더라도 다음에 열면 멈춘 곳부터 이어서 옮겨요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在逐字节复制并检查钱包和节点数据，可能需要几分钟。请保持 %@ 打开；如果关闭，下次会从停止处继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在逐位元組複製並確認錢包與節點資料，可能需要幾分鐘。請讓 %@ 保持開啟；若關閉，下次開啟會接續原本的進度。"
          }
        }
      }
    },
    "Your wallet is still moving over from Aether. Unlock this Mac to finish — your wallet is safe." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your wallet is still moving over from Aether. Unlock this Mac to finish — your wallet is safe."
