    },
    "Plug in and it restarts by itself within 30 s." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plug in and it restarts by itself within 30 s."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電源に接続すると、30秒以内に自動で再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전원을 연결하면 30초 안에 저절로 다시 시작해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接通电源后，会在 30 秒内自动重启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接上電源後，會在 30 秒內自動重新啟動。"
          }
        }
      }
    },
    "Power settings cannot be read. Turn this Mac on by hand after a power cut." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Power settings cannot be read. Turn this Mac on by hand after a power cut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電源設定を読み取れません。停電後はこのMacを手動で起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전원 설정을 읽을 수 없어요. 정전 뒤에는 이 Mac을 직접 켜 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取电源设置，断电后请手动打开此 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取電源設定，停電後請手動啟動此 Mac。"
          }
        }
      }
    },
    "Power: roughly 5–6 W while only verifying (about 4 kWh a month); proving on the GPU adds roughly 28–50 W (about 20–36 kWh a month)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Power: roughly 5–6 W while only verifying (about 4 kWh a month); proving on the GPU adds roughly 28–50 W (about 20–36 kWh a month)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電力：検証のみで約5〜6 W（月に約4 kWh）。GPUで証明するとさらに約28〜50 W（月に約20〜36 kWh）使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전력: 검증만 할 때 약 5–6W(한 달 약 4kWh), GPU로 증명하면 약 28–50W가 더 들어요(한 달 약 20–36kWh)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "功耗：仅验证时约 5–6 W，每月约 4 kWh；使用 GPU 证明会增加约 28–50 W，每月约 20–36 kWh。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用電：約 5–6 瓦（僅驗證，每月約 4 度電）；以 GPU 證明會增加約 28–50 瓦（每月約 20–36 度電）。"
          }
        }
      }
    },
