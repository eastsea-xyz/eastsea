    "Off, the node fetches the recent state and catches up fast. On, it re-checks every block from the first and keeps the whole history." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off, the node fetches the recent state and catches up fast. On, it re-checks every block from the first and keeps the whole history."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフの場合は最近の状態を取得して素早く同期します。オンの場合は最初からすべてのブロックを再確認し、全履歴を保管します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꺼 두면 최근 상태만 받아 빠르게 따라가요. 켜면 처음 블록부터 전부 다시 확인하고 모든 기록을 보관해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭时，节点获取最近的状态并快速赶上。开启时，它从第一个区块重新检查，并保留完整历史。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉時，節點只取得最近的狀態，能快速追上進度。開啟時，會從第一個區塊重新檢查並保留完整紀錄。"
          }
        }
      }
    },
    "Off: proving pauses on battery and resumes five minutes after the power adapter returns." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: proving pauses on battery and resumes five minutes after the power adapter returns."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフの場合はバッテリー使用中に証明を止め、電源アダプタを接続して5分後に再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 배터리 사용 중에는 증명을 멈추고, 전원 어댑터를 연결하고 5분 뒤에 다시 시작해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭时，使用电池会暂停证明，接回电源适配器五分钟后恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
