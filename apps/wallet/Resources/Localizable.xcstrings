    "Country" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Country"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "국가"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "国"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "国家"
          }
        },
        "es" : {
