    " EastSea retries by itself; nothing was deleted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " EastSea retries by itself; nothing was deleted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " EastSeaが自動で再試行します。何も削除されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 동해가 알아서 다시 시도해요. 지운 것은 없어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " EastSea 会自动重试；没有删除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " EastSea 會自動重試，沒有刪除任何資料。"
          }
        }
      }
    },
    " This Mac is a voting node, so the other validators are waiting for it." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " This Mac is a voting node, so the other validators are waiting for it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " このMacは投票ノードのため、ほかの検証者が待っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 투표 노드라서 다른 검증자들이 기다리고 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 此 Mac 是投票节点，其他验证者正在等待它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 此 Mac 是投票節點，其他驗證者正在等候它。"
          }
        }
      }
    },
    "\"Start up automatically after a power failure\" is off. Turn it on in System Settings ▸ Battery (or Energy)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Start up automatically after a power failure\" is off. Turn it on in System Settings ▸ Battery (or Energy)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「停電後に自動的に起動」がオフです。システム設定 ▸ バッテリー（またはエネルギー）でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정전 후 자동 켜기가 꺼져 있어요. 시스템 설정 ▸ 배터리(또는 에너지)에서 '정전 후 자동으로 켜기'를 켜 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“电源故障后自动启动”已关闭。请在“系统设置”▸“电池”或“节能”中开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「停電後自動啟動」已關閉，請在「系統設定」▸「電池」（或「能源」）中開啟。"
          }
        }
      }
    },
