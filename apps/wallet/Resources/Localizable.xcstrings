        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버의 말을 믿는 대신, 앱에 들어 있는 네트워크 키로 이 기기가 직접 잔액을 확인했어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
