          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいバージョンでノードが正常に動かなかったため、前のバージョンに戻りました。修正版が届くと自動でインストールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
