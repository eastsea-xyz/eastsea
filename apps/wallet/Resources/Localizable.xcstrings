          }
        }
      }
    },
    "The node goes back to normal. Keep the history and turning it on again picks up where it left off." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반 노드로 돌아가요. 보관한 기록을 남겨 두면 다시 켤 때 이어서 써요."
          }
        }
      }
    },
    "The node is off." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노드가 꺼져 있어요."
          }
        }
      }
    },
    "The node is still starting. Try again in a minute." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
