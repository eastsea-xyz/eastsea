    "These rules run from mainnet genesis and can change only by a committee-signed upgrade." : {
      "comment" : "legal-English-on-terms: TermsSheet resolves this body from reviewed en/ko; other screens use their app language.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These rules run from mainnet genesis and can change only by a committee-signed upgrade."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このルールはメインネットの最初のブロックから適用されます。委員会が署名した更新でのみ変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 규칙은 메인넷 첫 블록부터 적용되고, 네트워크가 서명한 업그레이드로만 바뀌어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些规则从主网的第一个区块开始执行，只能通过委员会签名的升级更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
