          }
        }
      }
    },
    "This token is not on the wallet’s trusted list: its unit size is its own claim. You will confirm the exact unit count before sending." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This token is not on the wallet’s trusted list: its unit size is its own claim. You will confirm the exact unit count before sending."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このトークンはウォレットの信頼する一覧にありません。単位の大きさはトークン自身が示す値です。送る前に正確な単位数を確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지갑의 신뢰 목록에 없는 토큰이라 단위 크기는 토큰이 스스로 밝힌 값이에요. 보내기 전에 정확한 단위 수를 확인하게 돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此代币不在钱包的信任列表中，其单位大小由代币自行声明。发送前需要确认准确的单位数量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此代幣不在錢包的信任清單中，單位大小是代幣自行聲明。傳送前會請你確認確切的單位數。"
          }
        }
      }
    },
