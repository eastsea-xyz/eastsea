      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This resends the payment that did not go through (number %llu) at the current fee. Both share that number, so only one of them can go through."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了しなかった支払い（番号%llu）を現在の手数料で再送します。2つの支払いは同じ番号のため、どちらか一方だけが完了できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처리되지 않은 결제(번호 %llu)를 지금 수수료로 다시 보내요. 둘이 같은 번호라 둘 중 하나만 처리돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按当前手续费重发未成功的付款，编号为 %llu。两笔付款使用相同编号，因此只能有一笔成功。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以目前手續費重新傳送未完成的付款（編號 %llu）。兩筆使用相同編號，因此只有一筆可完成。"
          }
        }
      }
    },
