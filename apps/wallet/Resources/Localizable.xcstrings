    "AI agent payments" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI agent payments"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIエージェントの支払い"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 에이전트 결제"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 代理付款"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人工智慧代理付款"
          }
        }
      }
    },
    "AI agents on this Mac, like Claude Code or Codex, can pay from this wallet — only to payees you approve and within the limits you set with Touch ID. The network refuses anything over those limits." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI agents on this Mac, like Claude Code or Codex, can pay from this wallet — only to payees you approve and within the limits you set with Touch ID. The network refuses anything over those limits."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude CodeやCodexなど、このMacのAIエージェントがウォレットから支払えます。承認した受取人にのみ、Touch IDで設定した上限内で送れます。上限を超える支払いはネットワークが拒否します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code나 Codex 같은 이 Mac의 AI 에이전트가 이 지갑에서 결제할 수 있어요. 내가 승인한 받는 곳에만, Touch ID로 정한 한도 안에서만 보낼 수 있고, 한도를 넘는 결제는 네트워크가 막아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 上的 Claude Code、Codex 等 AI 代理可以通过这个钱包付款，只能付给你批准的收款人，并遵守你用 Touch ID 设置的限额。网络会拒绝超出限额的付款。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 或 Codex 等此 Mac 上的人工智慧代理可用這個錢包付款。只能付給你批准的收款人，且須在你透過 Touch ID 設定的限額內。網路會拒絕超出限額的付款。"
          }
        }
      }
    },
