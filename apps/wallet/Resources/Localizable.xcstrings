    "The Mac is busy, so proving rests. It resumes when things calm down." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac is busy, so proving rests. It resumes when things calm down."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macが忙しいため、証明を休んでいます。落ち着くと再開します。"
