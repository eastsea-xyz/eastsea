            "value" : "진행 중: %3$@…에서 %1$@ %2$@ · %4$@부터 가능"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待中：来自 %3$@… 的 %1$@ %2$@ · %4$@ 起可执行"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
