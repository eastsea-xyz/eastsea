    },
    "The balance was too low when this payment was checked. This payment is not recorded on chain yet." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The balance was too low when this payment was checked. This payment is not recorded on chain yet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この支払いの確認時に残高が不足していました。この支払いはまだチェーンに記録されていません。"
