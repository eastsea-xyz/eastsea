    "Proving also runs at a lower scheduler priority, so the node and this Mac's work come first." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proving also runs at a lower scheduler priority, so the node and this Mac's work come first."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "証明は低い優先度で動くため、ノードとこのMacのほかの作業を優先します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "증명은 낮은 우선순위로 돌아가서 노드와 이 Mac의 다른 작업이 먼저예요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
