    },
    "The block data is being copied and checked at its new place. The wallet keeps working." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The block data is being copied and checked at its new place. The wallet keeps working."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロックデータを新しい保存先へコピーして確認しています。その間もウォレットは使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "블록 데이터를 새 위치로 복사하고 확인하는 중이에요. 지갑은 그동안에도 써요."
          }
        },
        "zh-Hans" : {
