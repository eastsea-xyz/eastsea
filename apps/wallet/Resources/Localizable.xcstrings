    "Private browsing keeps no history or cookies after this tab closes." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private browsing keeps no history or cookies after this tab closes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライベートブラウズは履歴を保存せず、このタブを閉じるとクッキーも残りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비공개 탐색에서는 방문 기록을 남기지 않고, 탭을 닫으면 쿠키도 지워져요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭此无痕标签页后，不会保留浏览记录或网站数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉此私密分頁後，不會保留瀏覽記錄或網站資料。"
          }
        }
      }
    },
    "Private keys stay on this device. Addresses, balances, transactions, rewards and registration records are public on chain indefinitely, even after you stop using the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private keys stay on this device. Addresses, balances, transactions, rewards and registration records are public on chain indefinitely, even after you stop using the app."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인키는 이 기기에 남아요. 주소, 잔액, 거래, 보상과 등록 기록은 앱 사용을 중단한 뒤에도 체인에서 무기한 공개돼요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "秘密鍵はこの端末に残ります。アドレス、残高、取引、報酬と登録記録は、アプリの使用をやめた後もチェーン上で無期限に公開されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私钥保留在此设备上。地址、余额、交易、奖励和注册记录在链上无限期公开，即使你停止使用应用也是如此。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves privadas permanecen en este dispositivo. Las direcciones, saldos, transacciones, recompensas y registros de inscripción son públicos en la cadena indefinidamente, incluso si dejas de usar la app."
          }
        }
      }
    },
