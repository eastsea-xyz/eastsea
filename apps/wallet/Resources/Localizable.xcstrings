    "The wallet key lives in this device's Secure Enclave, which only creates keys while the device is unlocked. %@ retries by itself." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wallet key lives in this device's Secure Enclave, which only creates keys while the device is unlocked. %@ retries by itself."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォレットのキーはこのデバイスのSecure Enclave内にあります。キーはデバイスのロックが解除されている間だけ作成できます。%@が自動で再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지갑 키는 이 기기의 Secure Enclave에 있고, Secure Enclave는 기기 잠금이 풀려 있을 때만 키를 만들어요. %@가 알아서 다시 시도해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钱包密钥保存在此设备的 Secure Enclave 中，只有设备解锁时才能创建。%@ 会自动重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錢包金鑰位於此裝置的 Secure Enclave，只能在裝置解鎖時建立金鑰。%@ 會自動重試。"
          }
        }
      }
