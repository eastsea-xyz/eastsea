  "font": {
    "family": {
      "display": {
        "web": "\"Newsreader\", \"Hahmlet\", \"New York\", ui-serif, Georgia, serif",
        "apple": "Font.Design.serif (New York)",
        "role": "Headlines and big numbers in editorial contexts. Optical-size serif: calm, precise."
      },
      "display-ko": {
        "web": "\"Hahmlet\", \"Newsreader\", \"AppleMyungjo\", ui-serif, serif",
        "apple": "Font.Design.serif (system Korean serif fallback)",
        "role": "Korean headlines. Pairs with Newsreader."
      },
      "text": {
        "web": "\"Geist\", \"Apple SD Gothic Neo\", \"Noto Sans KR\", system-ui, -apple-system, sans-serif",
        "apple": "Font.Design.default (SF Pro / Apple SD Gothic Neo)",
        "role": "UI and body text"
      },
      "mono": {
        "web": "\"Geist Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
        "apple": "Font.Design.monospaced (SF Mono)",
        "role": "Amounts, addresses, block numbers, labels. Always tabular."
      },
      "amount": {
        "web": "\"Geist\", system-ui, sans-serif",
        "apple": "Font.Design.rounded is RETIRED for amounts; use .default with .monospacedDigit()",
        "role": "Balance figures: tabular lining numerals"
      }
    },
    "files": {
      "Newsreader": "site/fonts/newsreader-*.woff2 (SIL OFL 1.1, Production Type)",
      "Hahmlet": "site/fonts/hahmlet-ko-subset.woff2 (SIL OFL 1.1, Hypertype) - subset to the page's headline glyphs",
      "Geist": "site/fonts/geist-*.woff2 (SIL OFL 1.1, Vercel)",
      "Geist Mono": "site/fonts/geist-mono-*.woff2 (SIL OFL 1.1, Vercel)"
    },
