  "motion": {
    "duration": {
      "fast": 120,
      "base": 240,
      "slow": 600,
      "scene": 1400
    },
    "easing": {
      "standard": "cubic-bezier(.2,.7,.2,1)",
      "exit": "cubic-bezier(.4,0,1,1)"
    },
    "rule": "All motion is decorative and must stop under prefers-reduced-motion (web) / accessibilityReduceMotion (Apple)."
  },
  "tokenIcon": {
    "source": "apps/wallet/Sources/TokenIconSpec.swift (adopted 2026-10-04). This section restates its rules as design rules; the Swift file wins on any conflict.",
    "kinds": {
      "nativeCoin": "The gold doubloon (design/brand/dbln-coin-1024.png; dbln-coin-flat-256.png below 48 pt). Only the chain's native coin.",
      "official": "Bundled art for tokens on the shipped trust list (TokenGuard.swift KnownTokens), keyed by ADDRESS, never by symbol. Files: design/brand/tokens/<SYMBOL>-256.png.",
      "generated": "Everything else: a deterministic glyph from the lowercase address (FNV-1a seed -> hue) and the symbol's first letter."
    },
    "official": {
      "shape": "Full circle, solid saturated fill, 1px inner rim at 55% white.",
      "palette": "Brand colours of this system (navy, gold, sea, dawn) and their tints; no gradients beyond one soft radial light.",
      "never": [
        "imitate another project's trademarked logo",
        "text or tickers inside the art",
        "URLs or fetched images of any kind"
      ]
    },
    "generated": {
      "fill": "Pastel HSL(hue(seed), 45%, 62%) - always quieter than official art",
      "ring": "DASHED ring - the shape, not only the colour, says 'unverified'",
      "badge": "'?' corner badge",
      "letter": "Symbol's first non-space character, uppercased; '?' if empty. Font: text, semibold.",
      "a11y": "VoiceOver label 'Unverified token'; official art reads '<SYMBOL>, verified'."
    },
    "sizes": {
      "row": 28,
      "list-large": 40,
      "detail": 64,
      "flat-below": 48
    }
  }
