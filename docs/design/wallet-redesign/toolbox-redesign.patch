diff --git a/apps/shared/toolbox.css b/apps/shared/toolbox.css
new file mode 100644
index 0000000..b2762fc
--- /dev/null
+++ b/apps/shared/toolbox.css
@@ -0,0 +1,170 @@
+/* EastSea toolbox presentation. Semantic values come from design-tokens.css. */
+@font-face {
+  font-family: "Newsreader";
+  src: url("./fonts/newsreader-latin.woff2") format("woff2");
+  font-style: normal;
+  font-weight: 200 800;
+  font-display: swap;
+}
+@font-face {
+  font-family: "Geist";
+  src: url("./fonts/geist-latin.woff2") format("woff2");
+  font-style: normal;
+  font-weight: 100 900;
+  font-display: swap;
+}
+@font-face {
+  font-family: "Geist Mono";
+  src: url("./fonts/geist-mono-latin.woff2") format("woff2");
+  font-style: normal;
+  font-weight: 100 900;
+  font-display: swap;
+}
+
+* { box-sizing: border-box; }
+body {
+  margin: 0;
+  background: var(--c-bg);
+  color: var(--c-text);
+  font: var(--text-body-ui-size)/1.65 var(--font-text);
+  -webkit-font-smoothing: antialiased;
+}
+::selection { background: var(--c-accent-fill); color: var(--c-on-accent-fill); }
+header, main, footer { width: min(100%, 1120px); margin-inline: auto; padding-inline: var(--space-8); }
+header { padding-block: var(--space-12) var(--space-6); }
+.brand {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3);
+  color: var(--c-text);
+  font: var(--weight-regular) 24px/1.25 var(--font-display);
+  letter-spacing: var(--text-title-2-tracking);
+  margin-bottom: var(--space-6);
+}
+.brand::before {
+  content: "";
+  width: var(--space-8);
+  height: var(--space-8);
+  flex: none;
+  background: url("./dawn-flat.svg") center / contain no-repeat;
+}
+h1 {
+  font: var(--weight-regular) clamp(38px, 4.5vw, 60px)/1.08 var(--font-display);
+  letter-spacing: var(--text-title-1-tracking);
+  margin: 0 0 var(--space-3);
+  text-wrap: balance;
+}
+h2 {
+  font: var(--weight-semibold) var(--text-headline-size)/var(--text-headline-line) var(--font-text);
+  color: var(--c-text);
+  margin: 0 0 var(--space-5);
+  letter-spacing: var(--text-headline-tracking);
+}
+p { margin: var(--space-3) 0; max-width: 75ch; overflow-wrap: anywhere; }
+.sub { color: var(--c-text-muted); font-size: var(--text-body-lg-size); margin: 0; }
+main { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--space-12); padding-bottom: var(--space-16); }
+.card {
+  min-width: 0;
+  margin-top: var(--space-8);
+  padding-top: var(--space-6);
+  border-top: 1px solid var(--c-line);
+}
+main > .card:nth-child(1), main > .card:nth-child(2), main > .card:nth-child(5) { grid-column: 1 / -1; }
+main > .es-plate { border: 0; margin-top: 0; padding: var(--space-6) var(--space-8); }
+.es-plate h2 { color: var(--c-plate-ink); margin-bottom: var(--space-3); }
+.es-plate .dim { color: var(--c-plate-soft); }
+.es-plate .ok { color: var(--c-plate-success); }
+.es-plate .warn { color: var(--c-plate-warn); }
+.es-plate .err { color: var(--c-plate-ink); }
+#contract { max-width: 720px; }
+button {
+  min-height: 44px;
+  max-width: 100%;
+  padding: var(--space-2) var(--space-5);
+  background: var(--c-surface);
+  color: var(--c-text);
+  border: 1px solid var(--c-line-control);
+  border-radius: var(--radius-pill);
+  font: var(--weight-medium) var(--text-body-ui-size)/var(--text-body-ui-line) var(--font-text);
+  cursor: pointer;
+  transition: background-color var(--dur-fast) var(--ease-standard), border-color var(--dur-fast) var(--ease-standard);
+}
+button:hover:not(:disabled) { background: var(--c-surface-sunken); border-color: var(--c-line-strong); }
+.actions button { background: var(--c-accent-fill); color: var(--c-on-accent-fill); border-color: transparent; }
+.actions button:hover:not(:disabled) { background: var(--c-accent-fill); filter: brightness(.96); }
+button:disabled { opacity: .5; cursor: default; }
+input, textarea {
+  display: block;
+  width: 100%;
+  min-height: 44px;
+  padding: var(--space-3) var(--space-4);
+  margin: var(--space-2) 0 var(--space-4);
+  background: var(--c-surface);
+  color: var(--c-text);
+  border: 1px solid var(--c-line-strong);
+  border-radius: var(--radius-sm);
+  font: var(--text-body-ui-size)/var(--text-body-ui-line) var(--font-mono);
+  font-variant-numeric: tabular-nums lining-nums;
+}
+input::placeholder, textarea::placeholder { color: var(--c-text-subtle); opacity: 1; }
+textarea { min-height: var(--space-24); resize: vertical; }
+:is(button, input, textarea, a):focus-visible { outline: 2px solid var(--c-focus); outline-offset: 3px; }
+label { display: block; color: var(--c-text-muted); font-size: var(--text-footnote-size); margin-top: var(--space-2); }
+form > label:first-child { margin-top: 0; color: var(--c-text); font-size: var(--text-body-ui-size); }
+form > label:first-child .mono { display: block; margin-top: var(--space-1); }
+form { border-top: 1px solid var(--c-line); padding-top: var(--space-5); margin-top: var(--space-5); }
+form:first-child { border-top: 0; padding-top: 0; margin-top: 0; }
+form p:empty, #chain:empty { display: none; }
+.row { display: flex; gap: var(--space-3); flex-wrap: wrap; }
+.row > * { flex: 1; min-width: 140px; }
+.hint { color: var(--c-text-muted); font-size: var(--text-footnote-size); margin: var(--space-2) 0 var(--space-3); }
+.dim { color: var(--c-text-muted); }
+.ok { color: var(--c-success); }
+.warn { color: var(--c-warn); }
+.err { color: var(--c-danger); }
+.mono, .txhash { font-family: var(--font-mono); font-size: var(--text-caption-size); font-variant-numeric: tabular-nums lining-nums; overflow-wrap: anywhere; word-break: break-word; }
+.wallets { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-3); }
+.wallets button { display: flex; align-items: center; gap: var(--space-2); }
+.dot { width: var(--space-2); height: var(--space-2); border-radius: var(--radius-pill); background: var(--c-success); display: inline-block; flex: none; }
+.log { border-top: 1px solid var(--c-line); padding-block: var(--space-4); margin: 0; font-size: var(--text-footnote-size); }
+.log b { color: var(--c-text); font-weight: var(--weight-medium); }
+a { color: var(--c-accent); text-underline-offset: .22em; text-decoration-thickness: 1px; }
+footer { color: var(--c-text-muted); font-size: var(--text-footnote-size); border-top: 1px solid var(--c-line); padding-block: var(--space-6) var(--space-12); }
+.hidden { display: none !important; }
+
+/* The catalog is a quiet index; the app itself carries the navy plate. */
+.catalog main { display: block; padding-top: var(--space-12); }
+.catalog h1 { font-size: clamp(36px, 4.5vw, 52px); line-height: 1.25; }
+.catalog main > p { color: var(--c-text-muted); line-height: 1.8; margin-block: var(--space-5) var(--space-10); }
+table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums lining-nums; }
+th, td { text-align: left; padding: var(--space-4) var(--space-3); border-bottom: 1px solid var(--c-line); }
+th { color: var(--c-text-muted); font-size: var(--text-caption-size); font-weight: var(--weight-medium); }
+th:first-child, td:first-child { padding-left: 0; width: var(--space-12); }
+td:nth-child(2) { width: 26%; font-weight: var(--weight-medium); }
+td:nth-child(3) { color: var(--c-text-muted); }
+td:last-child, th:last-child { text-align: right; padding-right: 0; }
+td a { color: var(--c-text); text-decoration: none; }
+td a:hover { color: var(--c-accent); text-decoration: underline; }
+tr:hover td { background: var(--c-surface); }
+
+@media (max-width: 720px) {
+  header, main, footer { padding-inline: var(--space-5); }
+  header { padding-top: var(--space-8); }
+  main { display: block; }
+  main > .es-plate { padding: var(--space-5); }
+  .brand { font-size: var(--text-title-3-size); }
+  .sub { font-size: var(--text-body-size); }
+  .catalog main { padding-top: var(--space-8); }
+  th, td { padding: var(--space-4) var(--space-2); font-size: var(--text-footnote-size); }
+  td:nth-child(2) { width: 38%; }
+  td:last-child, th:last-child { display: none; }
+}
+@media (prefers-reduced-motion: reduce) {
+  button { animation: none !important; transition: none !important; }
+}
+@media (forced-colors: active) {
+  .brand::before { display: none; }
+  .es-plate :is(.dim, .ok, .warn, .err) { color: CanvasText; }
+  button { border-color: ButtonText; }
+  input, textarea { border-color: CanvasText; }
+}
