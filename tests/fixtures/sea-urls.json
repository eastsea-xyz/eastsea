  "cases": [
    {
      "id": "short sea scheme",
      "input": "sea://harbor",
      "operation": "parse",
      "chainID": 1,
      "expected": {
        "kind": "name",
        "name": "harbor.sea",
        "canonicalURL": "sea://harbor.sea/",
        "path": "/",
        "query": null,
        "isLegacy": false,
        "registryName": "harbor.sea"
      }
    },
